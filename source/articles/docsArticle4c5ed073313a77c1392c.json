    {
      "kind": "heading",
      "level": 2,
      "text": "Documentation Ownership Rule",
      "anchor": "documentation-ownership-rule"
    },
    {
      "kind": "paragraph",
      "text": "If a page explains how a user performs a task, it belongs in `gDocs`."
    },
    {
      "kind": "paragraph",
      "text": "If a page explains the exact behavior owned by one module, it belongs in that module's `README.md` or `docs/` folder."
    },
    {
      "kind": "paragraph",
      "text": "If a page defines rules that AI tools and developers must follow while changing code, it belongs in `AGENTS.md` or `gSetup/llm`."
    },
